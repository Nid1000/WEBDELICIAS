APP_NAME="Delicias Bakery"
APP_ENV=local
APP_KEY=base64:uMu/eDWZ7Ig+2UJvS+BtfN8JoGX4fLZCkp79DJWjAZs=
APP_DEBUG=true
APP_URL=http://localhost:5001

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_GT

LOG_CHANNEL=stack
LOG_LEVEL=debug

# DB (Laravel)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=delicias_bakery
DB_USERNAME=root
DB_PASSWORD=

# Compat: si algún entorno usa connection string, la dejamos (NO es la usada por Laravel por defecto).
DATABASE_URL="mysql://root:@localhost:3306/delicias_bakery"

# JWT y otros secretos usados por la API
JWT_SECRET="delicias_jwt_secret_2024_muy_seguro"
DECOLECTA_TOKEN=""
DECOLECTA_BASE_URL="https://api.decolecta.com/v1"

# Configuración de archivos
UPLOAD_PATH="uploads/"
MAX_FILE_SIZE=5242880

# Mail (para Semana 6: proveedor + plantillas)
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="soporte@delicias.com"
MAIL_FROM_NAME="${APP_NAME}"

# Destinatarios internos
CONTACT_TO_ADDRESS="soporte@delicias.com"
CONTACT_TO_NAME="Soporte Delicias"
ADMIN_NOTIFICATIONS_EMAIL="soporte@delicias.com"

# IA (Semana 7: Ollama)
CHATBOT_ENABLE_OLLAMA=true
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1
OLLAMA_TIMEOUT_SECONDS=20

QUEUE_CONNECTION=sync
